# 复制为 .env 后使用。真实密钥只保存在本机，禁止提交。
HTTP_ADDR=:8080
MYSQL_DSN=just_for_you:local-development@tcp(127.0.0.1:3306)/just_for_you?parseTime=true&charset=utf8mb4&multiStatements=true
JWT_SECRET=replace-with-at-least-32-random-bytes
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
ENABLE_SOLO_TEST=false
WECHAT_TEMPLATE_MOMENT_ID=
WECHAT_TEMPLATE_PRESENCE_ID=
WECHAT_TEMPLATE_NUDGE_ID=
COS_BUCKET_URL=https://replace-with-your-private-cos-bucket.example.com
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
