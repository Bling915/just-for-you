<view class="page safe-page"><view class="eyebrow">JUST FOR US</view><view class="title">我的</view><view class="profile"><view class="avatar">{{initial}}</view><view class="name">{{user.displayName || '还没有昵称'}}</view><view class="caption">把平凡的小事，慢慢过成两个人的故事</view><button class="soft" bindtap="edit">编辑资料</button></view><view class="card"><view class="row"><view><view class="label">我们的关系</view><text>{{relationship ? '已经牵手，一起记录中' : '等待另一半加入'}}</text></view><view class="heart">♡</view></view><view wx:if="{{boundDate}}" class="since">从 {{boundDate}} 开始</view></view><view class="together-grid"><view data-url="/pages/anniversaries/index" bindtap="openTogether">⌛<text>纪念日</text></view><view data-url="/pages/todos/index" bindtap="openTogether">✓<text>共同待办</text></view><view data-url="/pages/wishes/index" bindtap="openTogether">◇<text>愿望清单</text></view></view><view class="actions"><button class="plain danger" bindtap="endRelationship">解除情侣关系</button><button class="plain" bindtap="logout">退出登录</button></view><view class="privacy">你的记录仅对当前绑定的两个人可见</view></view>
