.page{box-sizing:border-box;padding-bottom:150rpx}.eyebrow{margin-top:18rpx;color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:46rpx;font-weight:720}.profile{margin-top:46rpx;text-align:center}.avatar{width:154rpx;height:154rpx;margin:0 auto;border:8rpx solid rgba(255,255,255,.72);border-radius:50%;color:#fff;background:linear-gradient(145deg,#cbbbe2,var(--color-primary-deep));box-shadow:0 22rpx 54rpx rgba(128,106,168,.23);font-size:58rpx;line-height:154rpx}.name{margin-top:24rpx;font-size:36rpx;font-weight:680}.caption{margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.soft{width:240rpx;margin-top:26rpx;border:0;border-radius:38rpx;color:var(--color-primary-deep);background:var(--color-bg-lavender);font-size:24rpx}.soft::after,.plain::after{border:0}.card{margin-top:48rpx;padding:32rpx;border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card)}.row{display:flex;align-items:center;justify-content:space-between}.label{font-size:28rpx;font-weight:650}.row text,.since{display:block;margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.heart{color:var(--color-primary);font-size:50rpx}.since{padding-top:22rpx;border-top:1rpx solid rgba(157,135,193,.12)}.actions{margin-top:34rpx;border-radius:var(--radius-card);overflow:hidden;background:var(--color-card);box-shadow:var(--shadow-card)}.plain{height:92rpx;margin:0;border:0;border-radius:0;background:transparent;color:var(--color-text);font-size:26rpx}.plain+.plain{border-top:1rpx solid rgba(157,135,193,.1)}.plain.danger{color:var(--color-danger)}.privacy{margin-top:34rpx;color:var(--color-text-muted);font-size:20rpx;text-align:center}
