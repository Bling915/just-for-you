.page{text-align:center}.eyebrow{margin-top:90rpx;color:var(--color-primary);font-size:24rpx;letter-spacing:5rpx}.code{margin:40rpx 0 26rpx;font-size:80rpx;font-weight:700;letter-spacing:18rpx}.hint{max-width:560rpx;margin:20rpx auto 42rpx;color:var(--color-text-muted);font-size:26rpx;line-height:1.7}.primary{height:94rpx;line-height:94rpx;border:0;border-radius:47rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 16rpx 38rpx rgba(128,106,168,.22);font-size:29rpx}.primary::after{border:0}.moon{margin-top:44rpx;color:var(--color-primary);font-size:92rpx}.headline{font-size:42rpx;font-weight:700}.invite-card,.error-card{margin:42rpx 0;padding:42rpx;border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card)}.invite-card text,.creator{display:block;margin:12rpx}.creator{font-size:46rpx;color:var(--color-primary-deep)}.loading{margin-top:180rpx;color:var(--color-text-muted)}.error-card text{display:block;margin-top:18rpx;color:var(--color-danger);font-size:24rpx}
