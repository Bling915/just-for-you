<view class="page safe-page"><view wx:if="{{state==='loading'}}" class="notice">正在打开这份纪念…</view><view wx:elif="{{state==='error'}}" class="notice">暂时没有打开，再试一次吧。</view><view wx:else class="frame"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="photo">♡</view><view class="copy"><view class="eyebrow">OUR LITTLE MEMORY</view><view class="title">{{item.title}}</view><view class="days">{{item.days}}<text>天</text></view><view class="message">{{item.message || '把普通日子，慢慢过成我们的纪念。'}}</view><view class="date">{{item.targetDate}}</view></view></view><button wx:if="{{state==='ready'}}" class="edit" bindtap="edit">编辑纪念日</button></view>
