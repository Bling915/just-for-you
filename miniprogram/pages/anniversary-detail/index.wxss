.frame{margin-top:24rpx;padding:22rpx 22rpx 42rpx;border-radius:36rpx;background:#fff;box-shadow:0 24rpx 60rpx rgba(95,70,126,.16);transform:rotate(-.5deg)}.frame image,.photo{width:100%;height:650rpx;border-radius:26rpx}.photo{display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#ded0ec,#9d87c1);font-size:90rpx}.copy{padding:34rpx 18rpx 0;text-align:center}.eyebrow{color:#9d87c1;font-size:17rpx;letter-spacing:5rpx}.title{margin-top:14rpx;font-size:38rpx;font-weight:720}.days{margin-top:18rpx;color:#5b466f;font-family:Georgia,serif;font-size:84rpx}.days text{margin-left:8rpx;font-family:system-ui;font-size:22rpx}.message{margin-top:16rpx;color:#83798b;font-size:24rpx;line-height:1.8}.date{margin-top:16rpx;color:#9d87c1;font-size:20rpx}.edit{margin-top:30rpx;border:0;border-radius:44rpx;color:#806aa8;background:#eee7f8}.edit::after{border:0}.notice{margin-top:80rpx;color:#83798b;text-align:center}
