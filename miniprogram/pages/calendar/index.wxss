.head{display:flex;justify-content:space-between;align-items:flex-end}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:4rpx}.title{font-size:44rpx;font-weight:700}.month{padding:14rpx 20rpx;border-radius:999rpx;background:var(--color-card)}.week,.grid{display:grid;grid-template-columns:repeat(7,1fr)}.week{margin-top:44rpx;color:var(--color-text-muted);text-align:center}.cell{height:92rpx;margin:5rpx;border-radius:18rpx;text-align:center;padding-top:15rpx}.cell.today{background:var(--color-bg-lavender);color:var(--color-primary-deep)}.dot{width:32rpx;height:32rpx;margin:4rpx auto;border-radius:50%;color:#fff;background:var(--color-primary);font-size:18rpx;line-height:32rpx}
