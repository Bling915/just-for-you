<view class="page safe-page"><view class="top"><view class="eyebrow">TODAY'S LITTLE THING</view><view class="title">记录这一刻</view><view class="subtitle">不必特别，真实的日常就很珍贵。</view></view><view class="sheet"><textarea value="{{text}}" maxlength="-1" auto-height placeholder="今天发生了什么小事？" bindinput="inputText"/><view class="count">{{textCount}} / 500</view><view class="label">此刻的状态</view><view class="statuses"><view wx:for="{{statuses}}" wx:key="code" class="status {{status === item.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="selectStatus"><text>{{item.icon}}</text>{{item.label}}</view></view><view class="label">照片</view><photo-picker files="{{files}}" bind:change="filesChanged" bind:retry="retryPhoto"/><view class="label">在哪里</view><input value="{{placeName}}" maxlength="-1" placeholder="添加一个地点（可选）" bindinput="inputPlace"/><view class="count">{{placeCount}} / 80</view></view><view wx:if="{{publishing && total}}" class="progress">正在上传 {{completed}} / {{total}} 张照片</view><button class="publish" loading="{{publishing}}" disabled="{{publishing}}" bindtap="publish">{{publishing ? '正在珍藏…' : '珍藏这件小事'}}</button></view>
