<view class="page safe-page"><view class="eyebrow">OUR MILESTONES</view><view class="title">值得记住的日子</view><view class="form"><input placeholder="纪念日名称" value="{{title}}" bindinput="inputTitle"/><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="field">{{date || '选择日期'}}</view></picker><button bindtap="create">添加纪念日</button></view><view wx:if="{{!items.length}}" class="empty">从一个重要的日子开始吧。</view><view wx:for="{{items}}" wx:key="id" class="item"><view><view class="item-title">{{item.title}}</view><text>{{item.date.slice(0,10)}} · {{item.repeatsYearly ? '每年' : '仅一次'}}</text></view><button wx:if="{{item.systemKind === 'none'}}" data-id="{{item.id}}" bindtap="remove">删除</button></view></view>
