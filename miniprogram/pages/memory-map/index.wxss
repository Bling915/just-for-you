.map{width:100%;height:86vh}
.caption{padding:24rpx;text-align:center;color:var(--color-text-muted);font-size:21rpx}
.empty{margin:-180rpx 60rpx 0;padding:44rpx 36rpx;border-radius:var(--radius-card);background:rgba(255,252,253,.94);box-shadow:var(--shadow-card);text-align:center}
.empty-title{color:var(--color-text);font-size:30rpx;font-weight:650}
.empty-desc{margin-top:16rpx;color:var(--color-text-muted);font-size:23rpx;line-height:1.7}