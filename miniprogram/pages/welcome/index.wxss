.welcome { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.brand-orbit { width: 210rpx; height: 210rpx; border-radius: 50%; border: 2rpx solid rgba(157, 135, 193, .28); position: relative; margin-bottom: 56rpx; box-shadow: inset 0 0 55rpx rgba(157, 135, 193, .16); }
.brand-moon { position: absolute; width: 88rpx; height: 88rpx; right: 18rpx; bottom: 16rpx; border-radius: 50%; background: linear-gradient(145deg, #faf4ff, #bba7dd); box-shadow: -16rpx 18rpx 42rpx rgba(107, 82, 143, .22); animation: gentle-breathe 3.6s ease-in-out infinite; }
.eyebrow { color: var(--color-primary); font-size: 20rpx; font-weight: 600; letter-spacing: 8rpx; }
.title { margin-top: 18rpx; color: var(--color-text); font-size: 58rpx; font-weight: 700; letter-spacing: 4rpx; }
.subtitle { max-width: 540rpx; margin-top: 22rpx; color: var(--color-text-muted); font-size: 27rpx; line-height: 1.8; }
