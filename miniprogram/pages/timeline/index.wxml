<view class="page safe-page"><view class="top"><view><view class="eyebrow">OUR DAYS</view><view class="title">共同时间线</view></view><view class="spark">✦</view></view><view class="view-nav"><button data-url="/pages/calendar/index" bindtap="openView">日历</button><button data-url="/pages/memory-map/index" bindtap="openView">地图</button><button data-url="/pages/monthly-report/index" bindtap="openView">月报</button></view><block wx:if="{{loading}}"><skeleton-card/><skeleton-card/></block><empty-state wx:elif="{{!moments.length}}" title="故事从第一件小事开始" action="记录小事" bind:action="compose"/><block wx:else><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" current-user-id="{{currentUserId}}" bind:edit="edit" bind:delete="remove" bind:previewphotos="preview"/><view class="footer">{{loadingMore ? '正在翻开下一页…' : hasMore ? '继续向下' : '已经看到故事的开头了'}}</view></block><floating-compose-button bind:compose="compose"/></view>
