<view class="page safe-page"><view class="top"><view><view class="eyebrow">OUR DAYS</view><view class="title">共同时间线</view></view><view class="spark">✦</view></view><block wx:if="{{loading}}"><skeleton-card/><skeleton-card/><skeleton-card/></block><empty-state wx:elif="{{error && !moments.length}}" title="时间线暂时走丢了" description="等网络好一点，它会带着你们的小事回来。" action="重新加载" bind:action="retry"/><empty-state wx:elif="{{!moments.length}}" title="故事从第一件小事开始" description="拍一张照片，写一句今天，属于你们的时间线就亮起来了。" action="记录小事" bind:action="compose"/><block wx:else><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" current-user-id="{{currentUserId}}" bind:delete="remove" bind:previewphotos="preview"/><view class="footer">{{loadingMore ? '正在翻开下一页…' : hasMore ? '继续向下，看看更早的小事' : '已经看到故事的开头了'}}</view></block><floating-compose-button bind:compose="compose"/></view>
