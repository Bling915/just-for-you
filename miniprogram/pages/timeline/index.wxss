.page{box-sizing:border-box;padding-bottom:190rpx}.top{display:flex;align-items:center;justify-content:space-between;margin:18rpx 6rpx 30rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.spark{width:72rpx;height:72rpx;border-radius:50%;color:var(--color-primary-deep);background:rgba(255,255,255,.65);box-shadow:var(--shadow-card);font-size:34rpx;line-height:72rpx;text-align:center}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
/* 视图切换：胶囊分段控件，贴合页面留白，不再是裸原生按钮 */
.view-nav{display:flex;gap:10rpx;margin:0 6rpx 38rpx;padding:8rpx;background:var(--color-card);border:1rpx solid var(--color-stroke);border-radius:999rpx;box-shadow:var(--shadow-card)}
.view-nav button{flex:1;margin:0;padding:0;height:64rpx;line-height:64rpx;border:0;border-radius:999rpx;background:transparent;color:var(--color-text-muted);font-size:24rpx;font-weight:600;letter-spacing:2rpx;transition:background var(--motion-fast),color var(--motion-fast),box-shadow var(--motion-fast)}
.view-nav button::after{border:0}
.view-nav button:active{background:var(--color-primary-soft);color:var(--color-primary-deep)}
