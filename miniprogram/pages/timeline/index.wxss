.page{box-sizing:border-box;padding-bottom:190rpx}.top{display:flex;align-items:center;justify-content:space-between;margin:18rpx 6rpx 46rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.spark{width:72rpx;height:72rpx;border-radius:50%;color:var(--color-primary-deep);background:rgba(255,255,255,.65);box-shadow:var(--shadow-card);font-size:34rpx;line-height:72rpx;text-align:center}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
