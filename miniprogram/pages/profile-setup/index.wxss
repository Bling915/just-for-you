.page { text-align: center; }.headline { margin-top: 70rpx; font-size: 48rpx; font-weight: 700; }.hint { margin: 18rpx auto 50rpx; color: var(--color-text-muted); font-size: 26rpx; }.avatar { width: 176rpx; height: 176rpx; padding: 0; overflow: hidden; border: 4rpx solid rgba(255,255,255,.9); border-radius: 50%; color: #fff; background: linear-gradient(145deg,#f5eaff,#ad98d0); box-shadow: var(--shadow-card); font-size: 58rpx; line-height: 168rpx; }.avatar::after{border:0}.avatar image{width:100%;height:100%}.avatar-tip{margin-top:16rpx;color:var(--color-text-muted);font-size:22rpx}.name-input{height:96rpx;margin:58rpx auto 0;padding:0 34rpx;border:1rpx solid rgba(157,135,193,.18);border-radius:28rpx;background:var(--color-card);box-shadow:var(--shadow-card);text-align:left}.primary{height:96rpx;line-height:96rpx;margin-top:36rpx;border:0;border-radius:48rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));font-size:30rpx}.primary::after{border:0}.error{margin-top:22rpx;color:var(--color-danger);font-size:24rpx}
