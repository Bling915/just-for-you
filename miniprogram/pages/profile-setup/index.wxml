<view class="page safe-page animate-in">
  <view class="headline">先认识一下你</view><view class="hint">以后，每一件小事都会带着你的名字。</view>
  <view class="avatar" aria-label="头像将由昵称首字生成"><text>{{initial}}</text></view>
  <view class="avatar-tip">头像会用昵称的第一个字生成</view>
  <input class="name-input" type="nickname" maxlength="30" placeholder="你的昵称" value="{{displayName}}" bindinput="inputName" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存并继续</button>
</view>
