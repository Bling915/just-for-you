.card{margin:24rpx 0;padding:30rpx;border:1rpx solid rgba(255,255,255,.72);border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card);backdrop-filter:blur(18rpx)}.top{display:flex;align-items:center}.avatar{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,var(--color-primary),var(--color-primary-deep));font-size:24rpx}.meta{flex:1;margin-left:20rpx;font-size:27rpx;font-weight:600}.meta text{display:block;margin-top:5rpx;color:var(--color-text-muted);font-size:21rpx;font-weight:400}.more{margin:0;padding:12rpx;color:var(--color-text-muted);background:transparent;font-size:22rpx;line-height:1.5}.more::after{border:0}.status{display:inline-block;margin-top:24rpx;padding:10rpx 20rpx;border-radius:999rpx;color:var(--color-primary-deep);background:var(--color-bg-lavender);font-size:23rpx}.body{margin-top:22rpx;font-size:29rpx;line-height:1.75;white-space:pre-wrap}.place{margin-top:22rpx;color:var(--color-text-muted);font-size:23rpx}
