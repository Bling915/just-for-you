.album-head{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:150rpx;padding:26rpx 28rpx;overflow:hidden;border:1rpx solid var(--color-stroke);border-radius:var(--radius-hero);background:linear-gradient(135deg,rgba(255,255,255,.9),rgba(242,234,251,.74));box-shadow:var(--shadow-float)}.album-head::before{position:absolute;top:-50rpx;right:70rpx;width:170rpx;height:170rpx;border-radius:50%;background:rgba(216,198,241,.26);content:""}.copy{position:relative;z-index:1;min-width:0}.eyebrow{color:var(--color-primary-deep);font-size:17rpx;letter-spacing:5rpx}.title{max-width:390rpx;margin-top:9rpx;overflow:hidden;color:var(--color-text);font-size:40rpx;font-weight:720;text-overflow:ellipsis;white-space:nowrap}.subtitle{margin-top:12rpx;color:var(--color-text-muted);font-size:21rpx}.subtitle>text{color:var(--color-primary-deep);font-size:27rpx;font-weight:700}.subtitle .solo{display:inline-block;margin-left:12rpx;padding:4rpx 9rpx;border-radius:999rpx;background:var(--color-primary-soft);font-size:16rpx;font-weight:500}.portraits{position:relative;display:flex;align-items:center;margin-left:18rpx}.portrait{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;overflow:hidden;border:5rpx solid rgba(255,255,255,.94);border-radius:50%;color:#fff;background:linear-gradient(145deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 10rpx 24rpx rgba(102,81,139,.2);font-size:24rpx}.portrait.partner{margin-left:-14rpx}.portrait image{width:100%;height:100%}.thread{position:absolute;z-index:3;right:57rpx;bottom:-16rpx;width:32rpx;height:32rpx;border-radius:50%;color:var(--color-primary-deep);background:#fff;box-shadow:0 4rpx 12rpx rgba(102,81,139,.16);font-size:18rpx;line-height:32rpx;text-align:center}@media(max-width:340px){.album-head{padding:22rpx}.title{max-width:290rpx;font-size:36rpx}.portrait{width:66rpx;height:66rpx}}
