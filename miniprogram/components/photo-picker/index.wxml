<view class="picker"><view wx:for="{{files}}" wx:key="path" class="photo"><image src="{{item.thumb || item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="preview"/><view class="remove" data-index="{{index}}" bindtap="remove">×</view><view wx:if="{{item.status && item.status !== 'pending'}}" class="state {{item.status}}" data-index="{{index}}" bindtap="retry">{{item.status === 'success' ? '完成' : item.status === 'failed' ? '重试' : item.status === 'compressing' ? '压缩中' : item.status === 'granting' ? '准备中' : '上传 ' + item.progress + '%'}}</view><view class="order"><text data-index="{{index}}" data-direction="-1" bindtap="move">‹</text><text data-index="{{index}}" data-direction="1" bindtap="move">›</text></view></view><button wx:if="{{files.length < 9}}" class="add" bindtap="choose"><text>＋</text><view>{{files.length}} / 9</view></button></view>
