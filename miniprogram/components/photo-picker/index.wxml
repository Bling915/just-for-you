<view class="picker"><view wx:for="{{files}}" wx:key="path" class="photo"><image src="{{item.thumb || item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="preview" aria-role="button" aria-label="预览第 {{index + 1}} 张照片"/><view class="remove" data-index="{{index}}" bindtap="remove" aria-role="button" aria-label="删除第 {{index + 1}} 张照片">×</view><view wx:if="{{item.status && item.status !== 'pending'}}" class="state {{item.status}}" data-index="{{index}}" bindtap="retry" aria-role="button" aria-label="第 {{index + 1}} 张照片，{{item.status === 'failed' ? '可重试' : '上传状态'}}">{{item.status === 'success' ? '完成' : item.status === 'failed' ? '重试' : '上传中'}}</view><view class="order"><text data-index="{{index}}" data-direction="-1" bindtap="move" aria-role="button" aria-label="将第 {{index + 1}} 张照片前移">‹</text><text data-index="{{index}}" data-direction="1" bindtap="move" aria-role="button" aria-label="将第 {{index + 1}} 张照片后移">›</text></view></view><button wx:if="{{files.length < 9}}" class="add" bindtap="choose" aria-label="添加照片，当前已有 {{files.length}} 张，最多九张"><text>＋</text><view>{{files.length}} / 9</view></button></view>
