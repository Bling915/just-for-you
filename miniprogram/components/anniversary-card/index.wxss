.card{position:relative;display:flex;gap:24rpx;margin:22rpx 0;padding:22rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:rgba(255,255,255,.76);box-shadow:0 16rpx 42rpx rgba(111,84,147,.12)}.cover{width:178rpx;height:178rpx;flex:none;border-radius:24rpx}.fallback{display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#d9c9ea,#9d87c1);font-size:58rpx}.copy{min-width:0;flex:1;padding-top:6rpx}.meta{display:flex;gap:10rpx}.kind,.pin{padding:5rpx 12rpx;border-radius:999rpx;color:#806aa8;background:#f0eafa;font-size:18rpx}.pin{color:#a05f78;background:#fcecf2}.title{margin-top:14rpx;overflow:hidden;font-size:30rpx;font-weight:680;text-overflow:ellipsis;white-space:nowrap}.headline{margin-top:10rpx;color:#806aa8;font-family:Georgia,serif;font-size:34rpx}.date{margin-top:7rpx;color:#83798b;font-size:20rpx}.edit{position:absolute;right:14rpx;top:12rpx;padding:8rpx 14rpx;border:0;color:#83798b;background:transparent;font-size:20rpx}.edit::after{border:0}
