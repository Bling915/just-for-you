@keyframes gentle-fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes gentle-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.025); }
}
@keyframes paper-arrive { from{opacity:0;transform:translateY(18rpx) rotate(0)} to{opacity:1;transform:translateY(0) rotate(var(--card-rotate,0deg))} }
@keyframes sticker-pop { 0%{opacity:0;transform:scale(.72) rotate(-6deg)} 70%{transform:scale(1.08) rotate(2deg)} 100%{opacity:1;transform:scale(1) rotate(0)} }

.animate-in { animation: gentle-fade-up var(--motion-normal) ease-out both; }
.pressable { transition: transform var(--motion-fast) ease, opacity var(--motion-fast) ease; }
.pressable:active { opacity: .82; transform: scale(.985); }
.scrapbook-motion{animation:paper-arrive var(--motion-normal) var(--ease-paper) both}.sticker-pop{animation:sticker-pop var(--motion-slow) var(--ease-paper) both}
.reduce-motion, .reduce-motion .animate-in, .reduce-motion .orb, .reduce-motion .orb-skeleton, .reduce-motion .pressable { animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }
.reduce-motion .scrapbook-motion,.reduce-motion .sticker-pop{animation:gentle-fade-up 160ms ease-out both!important;transform:none!important}

@media (prefers-reduced-motion: reduce) {
  .animate-in, .orb, .brand-moon, .orb-skeleton, .line {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
  }
}
