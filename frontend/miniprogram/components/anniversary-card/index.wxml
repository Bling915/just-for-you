<view class="card" bindtap="open"><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="cover fallback">♡</view><view class="copy"><view class="meta"><text class="kind">{{item.mode === 'elapsed' ? '已经走过' : '值得期待'}}</text><text wx:if="{{item.pinned}}" class="pin">置顶</text></view><view class="title">{{item.title}}</view><view class="headline">{{item.headline}}</view><view class="date">{{item.targetDate}}</view></view><button class="edit" catchtap="edit">编辑</button></view>
