.perspective{position:relative;margin-top:24rpx;padding:24rpx;border-radius:22rpx;background:#fffaf3;box-shadow:0 8rpx 24rpx rgba(112,88,70,.08);transform:rotate(-.35deg)}.label{color:#9a755e;font-size:21rpx;letter-spacing:3rpx}.text{margin-top:14rpx;color:#54494f;font-size:27rpx;line-height:1.7;white-space:pre-wrap}.actions{display:flex;justify-content:flex-end;gap:8rpx}.actions button,.add{margin:12rpx 0 0;padding:10rpx 16rpx;color:#806aa8;background:transparent;font-size:21rpx;line-height:1.4}.actions button::after,.add::after{border:0}.add{border:1rpx dashed rgba(128,106,168,.35);border-radius:18rpx}
