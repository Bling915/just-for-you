<view wx:if="{{moment.perspective}}" class="perspective"><view class="label">TA 的视角</view><view wx:if="{{moment.perspective.text}}" class="text">{{moment.perspective.text}}</view><photo-grid wx:if="{{moment.perspective.photos.length}}" photos="{{moment.perspective.photos}}"/><view wx:if="{{moment.perspective.editable}}" class="actions"><button bindtap="edit">编辑</button><button bindtap="remove">删除</button></view></view><button wx:elif="{{canAdd}}" class="add" bindtap="add">＋ 写下我的视角</button>
