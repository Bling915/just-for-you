.picker{text-align:center}.avatar{position:relative;width:176rpx;height:176rpx;margin:0 auto;padding:0;overflow:visible;border:6rpx solid rgba(255,255,255,.9);border-radius:50%;color:#fff;background:linear-gradient(145deg,#f5eaff,#ad98d0);box-shadow:0 22rpx 54rpx rgba(128,106,168,.23);font-size:58rpx;line-height:164rpx}.avatar::after,.album::after{border:0}.avatar image{display:block;width:100%;height:100%;border-radius:50%}.camera{position:absolute;right:-4rpx;bottom:-4rpx;width:48rpx;height:48rpx;border:4rpx solid #fff;border-radius:50%;color:#fff;background:var(--color-primary-deep);font-size:22rpx;line-height:48rpx}.album{display:inline-block;margin:18rpx auto 0;padding:0 20rpx;border:0;color:var(--color-primary-deep);background:transparent;font-size:22rpx;line-height:1.8}.medium .avatar{width:154rpx;height:154rpx;font-size:52rpx;line-height:144rpx}
