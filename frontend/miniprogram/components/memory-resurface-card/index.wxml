<view wx:if="{{value}}" class="memory" bindtap="open"><view class="tape"></view><view class="caption"><text>{{value.reason}}</text><strong>{{value.title}}</strong></view><image wx:if="{{value.memory.photos.length}}" src="{{value.memory.photos[0].url}}" mode="aspectFill" catchtap="preview"/><view class="body">{{value.memory.text || value.memory.placeName || '一件值得想起的小事'}}</view><small>轻触回到共同时间线 →</small></view>
