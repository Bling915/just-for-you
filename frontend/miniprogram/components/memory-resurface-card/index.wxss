.memory{position:relative;margin:30rpx 8rpx;padding:30rpx;border:14rpx solid #fff;border-bottom-width:54rpx;border-radius:8rpx;background:#f8f2e8;box-shadow:0 18rpx 48rpx rgba(78,63,54,.15);transform:rotate(-1deg)}.tape{position:absolute;top:-32rpx;left:50%;width:150rpx;height:42rpx;background:rgba(225,207,170,.7);transform:translateX(-50%) rotate(2deg)}.caption text{display:block;color:#a77f5d;font-size:20rpx;letter-spacing:4rpx}.caption strong{display:block;margin-top:8rpx;font-size:34rpx}.memory image{width:100%;height:330rpx;margin-top:22rpx;border-radius:4rpx}.body{margin-top:20rpx;font-size:27rpx;line-height:1.7}.memory small{position:absolute;bottom:-40rpx;right:10rpx;color:#8e8184;font-size:20rpx}
