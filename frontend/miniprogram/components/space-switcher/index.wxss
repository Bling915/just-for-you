.switcher{display:flex;gap:12rpx;padding:8rpx;border:1rpx solid var(--color-stroke);border-radius:28rpx;background:rgba(255,255,255,.48)}.option{display:flex;align-items:center;gap:14rpx;flex:1;padding:18rpx;border-radius:22rpx;color:var(--color-text-muted);font-size:24rpx;transition:all var(--motion-fast)}.option>text{font-size:30rpx}.option small{display:block;margin-top:4rpx;font-size:18rpx;font-weight:400;opacity:.75}.option.active{color:var(--color-primary-deep);background:#fff;box-shadow:0 10rpx 24rpx rgba(110,87,145,.1);transform:translateY(-2rpx)}
