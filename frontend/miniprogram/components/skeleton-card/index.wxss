.card{margin:24rpx 0;padding:34rpx;border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card)}.line{height:24rpx;margin:24rpx 0;border-radius:12rpx;background:linear-gradient(90deg,#eee8f5 20%,#faf8fc 50%,#eee8f5 80%);background-size:200% 100%;animation:shine 1.5s linear infinite}.short{width:32%}.medium{width:68%}@keyframes shine{to{background-position:-200% 0}}
