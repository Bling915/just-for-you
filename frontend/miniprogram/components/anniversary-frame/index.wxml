<view class="frame {{template}}"><view class="tape"></view><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="photo">♡</view><view class="copy"><view class="eyebrow">OUR LITTLE MEMORY</view><view class="title">{{item.title}}</view><view class="days">{{item.days}}<text>天</text></view><view class="message">{{item.message || '把普通日子，慢慢过成我们的纪念。'}}</view><view class="date">{{item.targetDate}}</view></view></view>
