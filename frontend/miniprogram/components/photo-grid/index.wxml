<view class="grid grid--{{photos.length}}"><view wx:for="{{photos}}" wx:key="objectKey" class="cell" data-index="{{index}}" bindtap="preview" aria-role="button" aria-label="预览第 {{index + 1}} 张照片"><image wx:if="{{item.url && !failed[index]}}" src="{{item.url}}" mode="aspectFill" data-index="{{index}}" binderror="fail"/><view wx:else class="fallback">图片暂时走丢了</view></view></view>
