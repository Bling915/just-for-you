.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:24rpx}.grid--1{grid-template-columns:1fr}.grid--2{grid-template-columns:repeat(2,1fr)}.cell{overflow:hidden;min-height:190rpx;aspect-ratio:1;border-radius:18rpx;background:var(--color-bg-lavender)}.grid--1 .cell{aspect-ratio:1.55}.cell image{display:block;width:100%;height:100%}.fallback{height:100%;min-height:190rpx;display:flex;align-items:center;justify-content:center;padding:20rpx;color:var(--color-text-muted);font-size:22rpx;text-align:center}
