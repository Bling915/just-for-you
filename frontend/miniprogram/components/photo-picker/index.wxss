.picker{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.photo,.add{position:relative;overflow:hidden;aspect-ratio:1;border-radius:20rpx;background:var(--color-bg-lavender)}.photo image{width:100%;height:100%}.remove{position:absolute;right:8rpx;top:8rpx;width:42rpx;height:42rpx;border-radius:50%;color:#fff;background:rgba(64,57,70,.68);text-align:center;line-height:39rpx;font-size:34rpx}.state{position:absolute;inset:auto 0 0;padding:8rpx;color:#fff;background:rgba(64,57,70,.72);font-size:20rpx;text-align:center}.state.success{background:rgba(105,151,123,.82)}.state.failed{background:rgba(200,117,128,.86)}.order{position:absolute;left:7rpx;top:7rpx;display:flex;gap:5rpx}.order text{width:38rpx;height:38rpx;border-radius:50%;color:#fff;background:rgba(64,57,70,.55);line-height:34rpx;text-align:center;font-size:34rpx}.add{margin:0;padding:0;border:2rpx dashed rgba(157,135,193,.42);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--color-primary);background:rgba(255,255,255,.38);font-size:21rpx}.add::after{border:0}.add text{font-size:48rpx;font-weight:300}
