.picker{display:flex;gap:12rpx}.item{display:flex;align-items:center;gap:12rpx;flex:1;padding:18rpx;border:1rpx solid var(--color-stroke);border-radius:22rpx;color:var(--color-text-muted);background:rgba(255,255,255,.55);font-size:23rpx}.item>text{font-size:28rpx}.item small{display:block;margin-top:5rpx;font-size:18rpx}.item.active{color:var(--color-primary-deep);border-color:rgba(128,106,168,.35);background:var(--color-primary-soft)}.item.disabled{opacity:.48}
