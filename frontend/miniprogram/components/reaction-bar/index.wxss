.bar{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:22rpx}.chip{min-width:72rpx;margin:0;padding:10rpx 16rpx;border:1rpx solid rgba(139,113,171,.16);border-radius:999rpx;color:#735f89;background:#faf7fd;font-size:24rpx;line-height:1.3}.chip::after{border:0}.chip:active{transform:scale(.94);background:#efe6f7}.text{padding:10rpx 20rpx}.summary{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:12rpx}.count{padding:6rpx 12rpx;border-radius:999rpx;color:#887b91;background:#f4eff7;font-size:20rpx}.count.mine{color:#75558f;background:#e9ddf2}
