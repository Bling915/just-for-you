<view class="card scrapbook-motion pressable {{tiltClass}}" style="animation-delay:{{motionDelay}}ms;--card-rotate:{{tiltClass === 'tilt-right' ? '.32deg' : tiltClass === 'tilt-left' ? '-.32deg' : '0deg'}};transform:rotate(var(--card-rotate));box-shadow:var(--shadow-paper)">
  <view class="top"><view class="avatar"><image wx:if="{{moment.authorId === currentUserId ? currentUserAvatar : partnerAvatar}}" src="{{moment.authorId === currentUserId ? currentUserAvatar : partnerAvatar}}" mode="aspectFill" binderror="avatarError"/><text wx:else>{{moment.authorId === currentUserId ? '我' : 'TA'}}</text></view><view class="meta"><view>{{moment.authorId === currentUserId ? '我' : '对方'}}</view><text>{{displayTime}}</text></view><privacy-badge wx:if="{{moment.spaceType === 'personal'}}" visibility="{{moment.visibility}}"/><view wx:if="{{moment.authorId === currentUserId}}" class="actions"><button class="more" bindtap="edit">编辑</button><button class="more" bindtap="remove">删除</button></view></view>
  <view wx:if="{{moment.status}}" class="status">{{labels[moment.status]}}</view>
  <view wx:if="{{moment.text}}" class="body">{{moment.text}}</view>
  <photo-grid wx:if="{{moment.photos.length}}" photos="{{moment.photos}}" bind:preview="preview"/>
  <view wx:if="{{moment.placeName}}" class="place">⌖ {{moment.placeName}}</view>
  <button wx:if="{{canShare}}" class="share" bindtap="share">分享给我们 ✦</button>
  <reaction-bar reactions="{{moment.reactions || []}}" current-user-id="{{currentUserId}}" bind:toggle="react" bind:text="textReaction"/>
  <perspective-panel wx:if="{{moment.spaceType === 'shared'}}" moment="{{moment}}" current-user-id="{{currentUserId}}" bind:edit="editPerspective" bind:delete="deletePerspective"/>
</view>
