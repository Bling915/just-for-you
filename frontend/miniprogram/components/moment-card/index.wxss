.card{margin:24rpx 0;padding:30rpx;border:1rpx solid rgba(255,255,255,.72);border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card);backdrop-filter:blur(18rpx)}.top{display:flex;align-items:center}.avatar{width:72rpx;height:72rpx;overflow:hidden;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,var(--color-primary),var(--color-primary-deep));font-size:24rpx}.avatar image{width:100%;height:100%}.meta{flex:1;margin-left:20rpx;font-size:27rpx;font-weight:600}.meta text{display:block;margin-top:5rpx;color:var(--color-text-muted);font-size:21rpx;font-weight:400}.owner-menu{display:flex;align-items:center;justify-content:center;gap:6rpx;width:66rpx;height:54rpx;margin:0 0 0 10rpx;padding:0;border:1rpx solid rgba(128,106,168,.12);border-radius:20rpx;background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(242,235,249,.88));box-shadow:0 8rpx 20rpx rgba(94,75,126,.08)}.owner-menu::after{border:0}.owner-menu text{width:7rpx;height:7rpx;border-radius:50%;background:#89749f}.owner-menu:active{transform:scale(.94);background:#eee5f6}.status{display:inline-block;margin-top:24rpx;padding:10rpx 20rpx;border-radius:999rpx;color:var(--color-primary-deep);background:var(--color-bg-lavender);font-size:23rpx}.body{margin-top:22rpx;font-size:29rpx;line-height:1.75;white-space:pre-wrap}.place{margin-top:22rpx;color:var(--color-text-muted);font-size:23rpx}.share{margin:22rpx 0 0;padding:14rpx 22rpx;border:1rpx solid rgba(139,113,171,.18);border-radius:999rpx;color:#765b8d;background:linear-gradient(135deg,#f8f1fc,#f2e8f8);font-size:23rpx;line-height:1.4}.share::after{border:0}
.top{position:relative}.owner-actions{position:relative;margin-left:10rpx}.owner-actions .owner-menu{width:62rpx;height:52rpx;margin:0;border-radius:18rpx}.owner-menu.active{background:#eadef3}.owner-popover{position:absolute;z-index:12;top:64rpx;right:0;display:flex;gap:10rpx;padding:12rpx;border:1rpx solid rgba(132,105,157,.13);border-radius:24rpx;background:rgba(255,253,255,.98);box-shadow:0 18rpx 48rpx rgba(78,61,99,.2);animation:sticker-pop 180ms ease-out both}.owner-popover button{width:92rpx;margin:0;padding:10rpx 6rpx;border:0;border-radius:18rpx;color:var(--color-text-muted);background:#f8f4fb;font-size:19rpx;line-height:1.2}.owner-popover button::after{border:0}.owner-popover button:last-child{color:#ae6470;background:#fff4f5}.action-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;margin:0 auto 7rpx;border-radius:14rpx;font-size:24rpx}.edit-icon{color:#73568e;background:#eadff4}.delete-icon{color:#b65364;background:#f9dfe3}
