.swiper{height:270rpx;margin:0 0 54rpx}.card{position:relative;height:240rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.85);border-radius:34rpx;background:linear-gradient(135deg,#f6effc,#dfd0ee);box-shadow:0 18rpx 45rpx rgba(103,78,137,.14)}.card image,.shade{position:absolute;width:100%;height:100%}.shade{background:linear-gradient(90deg,rgba(70,48,86,.72),rgba(99,70,120,.3))}.copy{position:relative;padding:36rpx;color:#fff}.label{font-size:21rpx;letter-spacing:1rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.days{margin-top:13rpx;font-family:Georgia,serif;font-size:68rpx;line-height:1}.days text{margin-left:7rpx;font-family:system-ui;font-size:20rpx}.headline{margin-top:15rpx;font-size:20rpx;opacity:.86;white-space:nowrap}.arrow{position:absolute;right:28rpx;top:94rpx;color:#fff;font-size:48rpx}
.more{margin:-30rpx 8rpx 0;padding:16rpx 0;color:var(--color-primary-deep);font-size:22rpx;text-align:center}
