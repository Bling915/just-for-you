.orb-wrap{text-align:center}.orb{position:relative;width:210rpx;height:210rpx;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 35% 28%,#fff 0,#e8ddf8 38%,var(--color-primary) 100%);box-shadow:0 24rpx 68rpx rgba(128,106,168,.25),inset 0 0 32rpx rgba(255,255,255,.7);animation:orb-breathe 3.8s ease-in-out infinite}.orb--quiet{filter:saturate(.55);opacity:.8}.glow{position:absolute;inset:-18rpx;border:2rpx solid rgba(157,135,193,.16);border-radius:50%}.symbol{color:#fff;font-size:72rpx;text-shadow:0 4rpx 16rpx rgba(64,57,70,.15)}.label{margin-top:34rpx;font-size:34rpx;font-weight:650}.note{max-width:520rpx;margin:12rpx auto 0;color:var(--color-text-muted);font-size:25rpx;line-height:1.6}@keyframes orb-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.035)}}
