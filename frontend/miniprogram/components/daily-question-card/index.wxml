<view wx:if="{{view.state !== 'empty'}}" class="card"><view class="head"><text>今日一句</text><button bindtap="history">往日问题</button></view><view class="question">{{view.question}}</view><block wx:if="{{view.state === 'answer'}}"><textarea maxlength="500" value="{{answer}}" placeholder="写下你的答案，对方回答后一起解锁" bindinput="input"/><button class="submit" loading="{{submitting}}" bindtap="submit">藏好我的答案</button></block><view wx:elif="{{view.state === 'waiting'}}" class="waiting"><text>✓ 你的答案已经藏好</text><small>等 TA 回答后，就会一起出现在共同时间线</small></view><view wx:else class="answers"><view><small>我的答案</small><text>{{view.myAnswer}}</text></view><view><small>TA 的答案</small><text>{{view.partnerAnswer}}</text></view></view></view>
