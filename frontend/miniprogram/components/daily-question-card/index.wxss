.card{margin:26rpx 0;padding:30rpx;border:1rpx solid rgba(255,255,255,.8);border-radius:30rpx;background:linear-gradient(145deg,#fffaf1,#f8f1fb);box-shadow:var(--shadow-card);transform:rotate(.25deg)}.head{display:flex;align-items:center;justify-content:space-between;color:#957653;font-size:22rpx;letter-spacing:4rpx}.head button{margin:0;padding:8rpx;color:#806aa8;background:transparent;font-size:21rpx}.head button::after{border:0}.question{margin-top:22rpx;color:#4d4552;font-size:32rpx;font-weight:650;line-height:1.55}textarea{width:100%;height:160rpx;box-sizing:border-box;margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:rgba(255,255,255,.72);font-size:26rpx}.submit{margin-top:18rpx;border-radius:999rpx;color:#fff;background:#8d73ad;font-size:25rpx}.waiting{display:flex;flex-direction:column;gap:8rpx;margin-top:22rpx;padding:20rpx;border-radius:18rpx;color:#765f83;background:#f2eaf7}.waiting small{color:#93889a;font-size:21rpx}.answers{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.answers view{padding:20rpx;border-radius:18rpx;background:rgba(255,255,255,.75)}.answers small{display:block;color:#9a8ca0;font-size:20rpx}.answers text{display:block;margin-top:8rpx;font-size:25rpx;line-height:1.6}
