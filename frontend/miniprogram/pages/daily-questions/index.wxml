<view class="page safe-page"><view class="title">我们回答过的问题</view><view wx:if="{{loading}}">正在翻阅…</view><view wx:for="{{items}}" wx:key="id" class="item"><small>{{item.date}}</small><view class="question">{{item.question}}</view><view wx:if="{{item.state === 'unlocked'}}" class="answers"><text>我：{{item.myAnswer}}</text><text>TA：{{item.partnerAnswer}}</text></view><button wx:elif="{{item.state === 'answer'}}" data-item="{{item}}" bindtap="answer">补上我的答案</button><view wx:else class="waiting">我的答案已藏好，等待 TA</view></view></view>
