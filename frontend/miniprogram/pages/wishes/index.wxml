<view class="page safe-page"><view class="eyebrow">SOMEDAY WITH YOU</view><view class="title">愿望清单</view><view class="form"><input placeholder="想一起完成什么？" value="{{title}}" bindinput="inputTitle"/><button bindtap="create">许个愿</button></view><view wx:if="{{!active.length}}" class="empty">把想一起做的事放进这里。</view><view wx:for="{{active}}" wx:key="id" class="item"><view class="check" data-id="{{item.id}}" bindtap="complete">◇</view><view class="item-title">{{item.title}}</view><button data-id="{{item.id}}" bindtap="remove">删除</button></view><view wx:if="{{completed.length}}" class="completed-title" bindtap="toggle">实现的愿望 {{completed.length}} 个 {{showCompleted ? '⌃' : '⌄'}}</view><view wx:if="{{showCompleted}}" wx:for="{{completed}}" wx:key="id" class="item completed"><view class="check" data-id="{{item.id}}" bindtap="reopen">◆</view><view class="item-title">{{item.title}}</view></view></view>
