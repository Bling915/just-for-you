.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:4rpx}.title{margin:12rpx 0 36rpx;font-size:44rpx;font-weight:700}.form{display:flex;gap:14rpx;padding:22rpx;border-radius:28rpx;background:var(--color-card);box-shadow:var(--shadow-card)}.form input,.field{flex:1;height:72rpx;padding:0 18rpx;border-radius:18rpx;background:var(--color-bg-lavender);line-height:72rpx}.form button,.item button{margin:0;border:0;border-radius:18rpx;color:#fff;background:var(--color-primary);font-size:22rpx}.form button::after,.item button::after{border:0}.item{display:flex;align-items:center;gap:18rpx;margin-top:18rpx;padding:24rpx;border-radius:24rpx;background:var(--color-card)}.item-title{flex:1;font-size:27rpx}.item text,.empty{color:var(--color-text-muted);font-size:22rpx}.check{color:var(--color-primary);font-size:38rpx}.completed{opacity:.6}.completed-title,.empty{margin-top:32rpx;text-align:center}
