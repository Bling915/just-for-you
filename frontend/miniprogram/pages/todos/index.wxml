<view class="page safe-page"><view class="eyebrow">DO IT TOGETHER</view><view class="title">共同待办</view><view class="form"><input placeholder="下一件一起完成的小事" value="{{title}}" bindinput="inputTitle"/><button bindtap="create">添加待办</button></view><view wx:if="{{!active.length}}" class="empty">暂时没有待办，去安排一件期待的事吧。</view><view wx:for="{{active}}" wx:key="id" class="item"><view class="check" data-id="{{item.id}}" bindtap="complete">○</view><view class="item-title">{{item.title}}</view><button data-id="{{item.id}}" bindtap="remove">删除</button></view><view wx:if="{{completed.length}}" class="completed-title" bindtap="toggle">已完成 {{completed.length}} 件 {{showCompleted ? '⌃' : '⌄'}}</view><view wx:if="{{showCompleted}}" wx:for="{{completed}}" wx:key="id" class="item completed"><view class="check" data-id="{{item.id}}" bindtap="reopen">✓</view><view class="item-title">{{item.title}}</view></view></view>
