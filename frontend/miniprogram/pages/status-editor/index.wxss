.eyebrow{margin-top:30rpx;color:var(--color-primary);font-size:19rpx;letter-spacing:5rpx}.title{margin-top:14rpx;font-size:42rpx;font-weight:720}.subtitle{margin:14rpx 0 42rpx;color:var(--color-text-muted);font-size:24rpx}.sheet{padding:34rpx;border:1rpx solid rgba(157,135,193,.14);border-radius:38rpx;background:rgba(255,255,255,.76);box-shadow:var(--shadow-card)}.label{font-size:25rpx;font-weight:650}.spaced{margin-top:42rpx}.presets{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:24rpx}.preset{padding:24rpx 18rpx;border:1rpx solid rgba(128,106,168,.16);border-radius:24rpx;color:var(--color-text-muted);background:#fff;text-align:center}.preset text{margin-right:12rpx}.preset.active,.duration.active{color:var(--color-primary-deep);border-color:rgba(128,106,168,.55);background:#f0e9f9}.custom{box-sizing:border-box;margin-top:24rpx;padding:24rpx;border-radius:22rpx;background:#f8f4fb}.count{text-align:right;margin-top:8rpx;color:var(--color-text-muted);font-size:20rpx}.durations{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.duration{padding:15rpx 23rpx;border:1rpx solid rgba(128,106,168,.16);border-radius:999rpx;background:#fff;font-size:22rpx}.error{margin:24rpx 0;color:var(--color-danger);font-size:23rpx;text-align:center}.submit{margin-top:34rpx;height:92rpx;line-height:92rpx;border:0;border-radius:46rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));font-size:28rpx}.submit::after{border:0}
