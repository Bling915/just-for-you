.page{text-align:center}.orb{position:relative;width:170rpx;height:170rpx;margin:32rpx auto 44rpx;border-radius:50%;background:linear-gradient(145deg,#f7edff,#b39fd5);box-shadow:-18rpx 22rpx 55rpx rgba(111,84,148,.22);animation:gentle-breathe 3.8s ease-in-out infinite}.small-orb{position:absolute;width:58rpx;height:58rpx;right:-12rpx;bottom:12rpx;border-radius:50%;background:#f0ce7a;box-shadow:0 12rpx 25rpx rgba(185,143,57,.2)}.headline{font-size:46rpx;font-weight:700}.hint{max-width:570rpx;margin:18rpx auto 46rpx;color:var(--color-text-muted);font-size:26rpx;line-height:1.7}.primary,.secondary{height:92rpx;line-height:92rpx;border-radius:46rpx;font-size:29rpx}.primary{border:0;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 16rpx 38rpx rgba(128,106,168,.22)}.secondary{margin-top:22rpx;border:2rpx solid rgba(157,135,193,.22);color:var(--color-primary-deep);background:rgba(255,255,255,.6)}button::after{border:0}.divider{margin:34rpx 0;color:var(--color-text-muted);font-size:22rpx}.code{height:104rpx;border-radius:26rpx;background:rgba(255,255,255,.76);box-shadow:var(--shadow-card);font-size:38rpx;font-weight:600;letter-spacing:12rpx;text-align:center}.bound-card{padding:36rpx;border-radius:var(--radius-card);background:var(--color-card);box-shadow:var(--shadow-card);color:var(--color-primary-deep)}.error{margin-top:22rpx;color:var(--color-danger);font-size:24rpx}
.test-divider{margin:46rpx 0 22rpx;color:var(--color-text-muted);font-size:22rpx}.solo-test{height:86rpx;line-height:86rpx;border:2rpx dashed rgba(128,106,168,.3);border-radius:43rpx;color:var(--color-primary-deep);background:rgba(244,238,252,.7);font-size:27rpx}.solo-hint{margin-top:14rpx;color:var(--color-text-muted);font-size:22rpx;line-height:1.6}
