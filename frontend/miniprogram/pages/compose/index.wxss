.page{box-sizing:border-box;padding-bottom:80rpx}.top{padding:22rpx 8rpx 38rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:12rpx;font-size:46rpx;font-weight:720}.subtitle{margin-top:12rpx;color:var(--color-text-muted);font-size:24rpx}.sheet{padding:34rpx;border-radius:36rpx;background:var(--color-card);box-shadow:var(--shadow-card)}textarea{width:100%;min-height:210rpx;font-size:29rpx;line-height:1.75}input{height:82rpx;padding:0 22rpx;border-radius:20rpx;background:var(--color-bg-lavender);font-size:26rpx}.count{margin-top:10rpx;color:var(--color-text-muted);font-size:20rpx;text-align:right}.label{margin:38rpx 0 20rpx;font-size:25rpx;font-weight:650}.statuses{display:flex;gap:12rpx}.status{flex:1;padding:20rpx 8rpx;border:1rpx solid rgba(157,135,193,.2);border-radius:22rpx;color:var(--color-text-muted);background:rgba(255,255,255,.5);font-size:23rpx;text-align:center}.status text{display:block;margin-bottom:6rpx;font-size:30rpx}.status.active{color:var(--color-primary-deep);border-color:var(--color-primary);background:var(--color-bg-lavender);transform:translateY(-3rpx)}.row{display:flex;gap:16rpx}.row picker{flex:1}.field{height:82rpx;padding:0 22rpx;border-radius:20rpx;background:var(--color-bg-lavender);font-size:26rpx;line-height:82rpx}.location-actions{display:flex;gap:12rpx;margin-top:14rpx}.location-actions button{flex:1;margin:0;border:0;border-radius:18rpx;color:var(--color-primary-deep);background:var(--color-bg-lavender);font-size:23rpx}.location-actions button::after{border:0}.publish{height:96rpx;line-height:96rpx;margin-top:34rpx;border:0;border-radius:48rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 18rpx 42rpx rgba(128,106,168,.24);font-size:29rpx}.publish::after{border:0}.progress{margin-top:26rpx;color:var(--color-primary-deep);font-size:23rpx;text-align:center}
.located{margin-top:12rpx;color:var(--color-primary-deep);font-size:21rpx}
.draft-tip{display:flex;align-items:center;justify-content:space-between;margin:0 8rpx 18rpx;padding:18rpx 24rpx;border-radius:22rpx;color:var(--color-primary-deep);background:var(--color-bg-lavender);font-size:22rpx}.draft-tip text{color:var(--color-danger)}