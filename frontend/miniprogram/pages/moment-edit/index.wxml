<view class="page safe-page"><view class="top"><view class="eyebrow">KEEP THE MEMORY TRUE</view><view class="title">编辑这件小事</view><view class="subtitle">时间、地点和照片都可以重新整理。</view></view><view class="sheet"><textarea value="{{text}}" maxlength="-1" auto-height placeholder="发生了什么？" bindinput="inputText"/><view class="count">{{textCount}} / 500</view><view class="label">当时的状态</view><view class="statuses"><view wx:for="{{statuses}}" wx:key="code" class="status {{status === item.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="selectStatus"><text>{{item.icon}}</text>{{item.label}}</view></view><view class="label">照片</view><photo-picker files="{{files}}" bind:change="filesChanged"/><view class="label">发生时间</view><view class="row"><picker mode="date" value="{{occurredDate}}" end="{{today}}" bindchange="changeDate"><view class="field">{{occurredDate}}</view></picker><picker mode="time" value="{{occurredTime}}" bindchange="changeTime"><view class="field">{{occurredTime}}</view></picker></view><view class="label">在哪里</view><input value="{{placeName}}" maxlength="-1" placeholder="地点名称（可选）" bindinput="inputPlace"/><view class="location-actions"><button bindtap="chooseLocation">{{latitude !== null ? '重新选位置' : '选择位置'}}</button><button wx:if="{{placeName || latitude !== null}}" bindtap="clearLocation">清除</button></view><view wx:if="{{latitude !== null}}" class="located">⌖ 已标记位置，将显示在共同地图上</view><view class="count">{{placeCount}} / 80</view></view><view wx:if="{{saving && total}}" class="progress">正在处理 {{completed}} / {{total}} 张新照片</view><button class="publish" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '正在保存…' : '保存修改'}}</button></view>
