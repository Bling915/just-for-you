.page{box-sizing:border-box;padding-bottom:80rpx}.intro{margin:10rpx 6rpx 30rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.subtitle{margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.scope-tabs{display:flex;gap:8rpx;padding:8rpx;border:1rpx solid var(--color-stroke);border-radius:28rpx;background:rgba(255,255,255,.56);box-shadow:var(--shadow-card)}.scope-tabs button{flex:1;height:72rpx;margin:0;padding:0;border:0;border-radius:22rpx;color:var(--color-text-muted);background:transparent;font-size:23rpx;line-height:72rpx}.scope-tabs button::after{border:0}.scope-tabs button.active{color:var(--color-primary-deep);background:#fff;box-shadow:0 9rpx 24rpx rgba(101,77,135,.12);font-weight:650}.space-actions{display:flex;align-items:center;justify-content:space-between;min-height:78rpx;margin:12rpx 0 4rpx}.shared-tools{display:flex;gap:10rpx}.shared-tools navigator{padding:10rpx 18rpx;border-radius:999rpx;color:var(--color-primary-deep);background:rgba(255,255,255,.62);font-size:20rpx}.inline-compose{height:60rpx;margin:0;padding:0 22rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 10rpx 25rpx rgba(128,106,168,.2);font-size:21rpx;line-height:60rpx}.inline-compose::after{border:0}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
