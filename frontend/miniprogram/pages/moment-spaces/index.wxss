.page{box-sizing:border-box;padding-bottom:190rpx}.intro{margin:10rpx 6rpx 30rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.subtitle{margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.scope-tabs{display:flex;gap:8rpx;padding:8rpx;border:1rpx solid var(--color-stroke);border-radius:28rpx;background:rgba(255,255,255,.56);box-shadow:var(--shadow-card)}.scope-tabs button{flex:1;height:72rpx;margin:0;padding:0;border:0;border-radius:22rpx;color:var(--color-text-muted);background:transparent;font-size:23rpx;line-height:72rpx}.scope-tabs button::after{border:0}.scope-tabs button.active{color:var(--color-primary-deep);background:#fff;box-shadow:0 9rpx 24rpx rgba(101,77,135,.12);font-weight:650}.shared-tools{display:flex;justify-content:center;gap:12rpx;margin:20rpx 0 8rpx}.shared-tools navigator{padding:10rpx 22rpx;border-radius:999rpx;color:var(--color-primary-deep);background:rgba(255,255,255,.62);font-size:20rpx}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
