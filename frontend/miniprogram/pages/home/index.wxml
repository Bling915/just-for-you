<view class="page safe-page {{motionClass}}">
  <couple-header current-user="{{currentUser}}" partner="{{relationship.partner}}" days="{{relationshipDays}}" solo-test="{{relationship.soloTest}}" bind:openpartner="openPartnerMoments"/>
  <view class="space-entries"><view class="space-entry shared pressable" bindtap="openSharedMoments"><text>♡</text><view><strong>我们的小事</strong><small>两个人共同珍藏</small></view></view><view class="space-entry personal pressable" bindtap="openMyMoments"><text>✦</text><view><strong>我的小事</strong><small>属于自己的角落</small></view></view></view>
  <block wx:if="{{state === 'loading'}}"><view class="orb-skeleton"></view><skeleton-card/><skeleton-card/></block>
  <block wx:else>
    <view wx:if="{{state === 'error-with-cache'}}" class="notice" bindtap="retry">网络打了个盹，正在展示上次内容 · 点此重试</view>
    <view class="hero"><view class="hero-caption">TA 的此刻</view><status-orb moment="{{presenceMoment}}"/><view class="companion-actions"><button bindtap="editStatus">更新我的状态</button><button data-kind="miss_you" bindtap="sendNudge">♡ 想你了</button><button data-kind="hug" bindtap="sendNudge">抱抱</button><button data-kind="cheer_up" bindtap="sendNudge">加油</button></view></view>
    <pinned-anniversary-card wx:if="{{pinnedAnniversaries.length}}" items="{{pinnedAnniversaries}}" has-more="{{hasMorePinned}}" bind:open="openAnniversary" bind:openAll="openAnniversaries"/>
    <view wx:if="{{dailyQuestion || resurfacedMemory}}" class="today-inbox {{inboxExpanded ? 'expanded' : ''}}">
      <view class="inbox-head" bindtap="toggleInbox"><view><text>✦</text><view><strong>今日小信箱</strong><small>{{inboxExpanded ? '把今天的心意收好' : (dailyQuestion && resurfacedMemory ? '有两个小惊喜等你打开' : '有一个小惊喜等你打开')}}</small></view></view><text class="inbox-arrow">{{inboxExpanded ? '⌃' : '⌄'}}</text></view>
      <view wx:if="{{inboxExpanded}}" class="inbox-content"><daily-question-card wx:if="{{dailyQuestion}}" question="{{dailyQuestion}}" bind:submit="submitDailyAnswer" bind:history="openDailyQuestions"/><memory-resurface-card wx:if="{{resurfacedMemory}}" value="{{resurfacedMemory}}" bind:open="openResurfacedMemory"/></view>
    </view>
    <view class="section-head"><view>最近的小事</view><text>{{moments.length ? '慢慢收藏每个今天' : '从今天开始'}}</text></view>
    <empty-state wx:if="{{state === 'empty'}}"/>
    <empty-state wx:elif="{{state === 'error-empty'}}" title="暂时没有连上" description="可能只是网络打了个盹，等一下再看看。" action="重新加载" bind:action="retry"/>
    <view wx:else class="feed"><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" current-user-id="{{currentUserId}}" current-user-avatar="{{currentUserAvatar}}" partner-avatar="{{partnerAvatar}}" bind:edit="edit" bind:delete="remove" bind:previewphotos="preview" bind:react="react" bind:textreaction="textReaction" bind:editperspective="editPerspective" bind:deleteperspective="deletePerspective"/></view>
  </block>
</view>
<floating-compose-button bind:compose="compose"/>
