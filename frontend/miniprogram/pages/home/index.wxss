.page{box-sizing:border-box;padding-bottom:190rpx}.nav{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:62rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:8rpx;font-size:42rpx;font-weight:720}.pair{padding:12rpx 18rpx;border:1rpx solid rgba(157,135,193,.2);border-radius:999rpx;color:var(--color-text-muted);background:rgba(255,255,255,.45);font-size:19rpx}.hero{position:relative;margin:0 -8rpx 74rpx;padding:48rpx 20rpx 42rpx;border-radius:48rpx;background:radial-gradient(circle at 50% 20%,rgba(255,255,255,.92),rgba(238,229,249,.62));box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.7)}.hero-caption{text-align:center;margin-bottom:32rpx;color:var(--color-text-muted);font-size:21rpx;letter-spacing:4rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;font-size:34rpx;font-weight:650}.section-head text{color:var(--color-text-muted);font-size:21rpx;font-weight:400}.notice{margin:-28rpx 0 30rpx;padding:18rpx 22rpx;border-radius:18rpx;color:var(--color-primary-deep);background:rgba(240,234,250,.9);font-size:22rpx;text-align:center}.orb-skeleton{width:210rpx;height:210rpx;margin:70rpx auto;border-radius:50%;background:rgba(232,221,248,.8);animation:gentle-breathe 2s ease-in-out infinite}@media (max-width:340px){.pair{display:none}.page{padding-left:24rpx;padding-right:24rpx}.hero{margin-left:0;margin-right:0}}
.partner-card{display:flex;align-items:center;gap:22rpx;margin:-28rpx 0 32rpx;padding:24rpx 28rpx;border:1rpx solid rgba(157,135,193,.14);border-radius:30rpx;background:rgba(255,255,255,.68);box-shadow:0 12rpx 30rpx rgba(94,75,126,.08)}.partner-avatar{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;overflow:hidden;border-radius:50%;color:#fff;background:linear-gradient(145deg,#b8a0d9,#7f67aa);font-size:30rpx}.partner-avatar image{width:100%;height:100%}.partner-copy{flex:1;text-align:left}.partner-copy>view:first-child{display:flex;align-items:center;gap:14rpx;color:var(--color-text);font-size:28rpx;font-weight:650}.partner-copy>view:last-child{margin-top:7rpx;color:var(--color-text-muted);font-size:21rpx}.solo-badge{padding:5rpx 11rpx;border-radius:999rpx;color:var(--color-primary-deep);background:#eee7f8;font-size:18rpx;font-weight:500}
.companion-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12rpx;margin-top:30rpx}.companion-actions button{margin:0;padding:0 20rpx;height:60rpx;line-height:60rpx;border:1rpx solid rgba(128,106,168,.16);border-radius:999rpx;color:var(--color-primary-deep);background:rgba(255,255,255,.78);font-size:20rpx}.companion-actions button:first-child{color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep))}.companion-actions button::after{border:0}
.page couple-header{display:block;margin-bottom:40rpx}
.space-entries{display:flex;gap:16rpx;margin:-12rpx 0 44rpx}.space-entry{display:flex;align-items:center;gap:16rpx;flex:1;padding:24rpx 20rpx;border:1rpx solid var(--color-stroke);border-radius:28rpx;background:rgba(255,255,255,.7);box-shadow:0 12rpx 30rpx rgba(94,75,126,.08)}.space-entry>text{font-size:32rpx;color:var(--color-primary-deep)}.space-entry strong{display:block;font-size:25rpx}.space-entry small{display:block;margin-top:6rpx;color:var(--color-text-muted);font-size:18rpx}.space-entry.personal{transform:rotate(1deg)}
.today-inbox{margin:28rpx 0;padding:8rpx;border:1rpx solid rgba(151,126,180,.15);border-radius:30rpx;background:rgba(255,255,255,.66);box-shadow:0 14rpx 36rpx rgba(94,75,126,.08);overflow:hidden}.inbox-head{display:flex;align-items:center;justify-content:space-between;padding:22rpx 24rpx}.inbox-head>view{display:flex;align-items:center;gap:18rpx}.inbox-head>view>text{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:18rpx;color:#fff;background:linear-gradient(145deg,#b69ace,#806aa8);font-size:28rpx}.inbox-head strong,.inbox-head small{display:block}.inbox-head strong{font-size:27rpx}.inbox-head small{margin-top:6rpx;color:var(--color-text-muted);font-size:19rpx}.inbox-arrow{color:var(--color-primary-deep);font-size:30rpx}.inbox-content{padding:0 14rpx 10rpx;animation:gentle-fade-up var(--motion-normal) ease-out both}.today-inbox.expanded{background:rgba(255,253,255,.84)}
.page{padding-bottom:80rpx}.section-head{align-items:center}.section-head>view>text{display:block;margin-top:6rpx}.inline-compose{height:64rpx;margin:0;padding:0 24rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 10rpx 25rpx rgba(128,106,168,.2);font-size:22rpx;line-height:64rpx}.inline-compose::after{border:0}
