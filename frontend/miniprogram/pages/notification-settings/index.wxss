.eyebrow{color:var(--color-primary);letter-spacing:5rpx}.title{margin-top:12rpx;font-size:44rpx;font-weight:700}.tip{margin:24rpx 0;color:var(--color-text-muted);line-height:1.7}.card{padding:8rpx 28rpx;border-radius:30rpx;background:var(--color-card);box-shadow:var(--shadow-card)}.row{display:flex;align-items:center;justify-content:space-between;padding:30rpx 0}.row+.row{border-top:1rpx solid rgba(128,106,168,.12)}
