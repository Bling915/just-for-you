.eyebrow{color:#9d87c1;font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:42rpx;font-weight:720}.cover{display:flex;align-items:center;justify-content:center;height:350rpx;margin-top:34rpx;overflow:hidden;border:2rpx dashed rgba(157,135,193,.35);border-radius:34rpx;color:#806aa8;background:linear-gradient(145deg,#fbf8ff,#eee7f8);text-align:center}.cover image{width:100%;height:100%}.cover text{display:block;font-size:54rpx}.cover view view{margin-top:10rpx;font-size:23rpx}.form{margin-top:28rpx;padding:30rpx;border-radius:30rpx;background:rgba(255,255,255,.76);box-shadow:0 18rpx 48rpx rgba(119,96,150,.1)}.label{margin:28rpx 0 12rpx;color:#83798b;font-size:21rpx}.form>.label:first-child{margin-top:0}.form input,.field,.form textarea{box-sizing:border-box;width:100%;padding:24rpx;border-radius:20rpx;background:#f8f4fb;font-size:27rpx}.form textarea{height:180rpx}.segments{display:flex;padding:6rpx;border-radius:22rpx;background:#f1ebf8}.segments view{flex:1;padding:20rpx;text-align:center;color:#83798b}.segments .active{border-radius:18rpx;color:#5b466f;background:#fff;box-shadow:0 7rpx 18rpx rgba(91,70,111,.1)}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid rgba(157,135,193,.12)}.switch-row b,.switch-row text{display:block}.switch-row b{font-size:26rpx}.switch-row text{margin-top:7rpx;color:#83798b;font-size:20rpx}.error{margin:22rpx;color:#c87580;text-align:center}.save{height:94rpx;margin-top:30rpx;border:0;border-radius:47rpx;color:#fff;background:linear-gradient(135deg,#ad96ce,#806aa8);font-size:29rpx;line-height:94rpx}.save::after,.delete::after{border:0}.delete{margin-top:18rpx;border:0;color:#c87580;background:transparent;font-size:23rpx}
