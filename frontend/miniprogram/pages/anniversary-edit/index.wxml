<view class="page safe-page"><view class="eyebrow">KEEP THIS DAY</view><view class="title">{{id ? '编辑这份纪念' : '记下一个特别日子'}}</view><view class="cover" bindtap="chooseCover"><image wx:if="{{coverPreview}}" src="{{coverPreview}}" mode="aspectFill"/><view wx:else><text>＋</text><view>添加一张封面照片</view></view></view><view class="form"><view class="label">名称</view><input value="{{title}}" data-field="title" bindinput="input" maxlength="60" placeholder="例如：我们第一次见面"/><view class="label">日期</view><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="field">{{date || '选择日期'}}</view></picker><view class="label">怎样记录时间</view><view class="segments"><view class="{{countMode==='elapsed'?'active':''}}" data-mode="elapsed" bindtap="changeMode">已经走过</view><view class="{{countMode==='countdown'?'active':''}}" data-mode="countdown" bindtap="changeMode">值得期待</view></view><view class="switch-row"><view><b>每年重复</b><text>适合生日和每年的纪念日</text></view><switch color="#9d87c1" checked="{{repeatsYearly}}" data-field="repeatsYearly" bindchange="toggle"/></view><view class="switch-row"><view><b>在首页置顶</b><text>首页会展示这张纪念卡</text></view><switch color="#9d87c1" checked="{{pinned}}" data-field="pinned" bindchange="toggle"/></view><view class="label">写一句话</view><textarea value="{{message}}" data-field="message" bindinput="input" maxlength="120" placeholder="留给这一天的一句话…"/></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving?'正在保存…':'保存纪念日'}}</button><button wx:if="{{id && systemKind==='none'}}" class="delete" bindtap="remove">删除这个纪念日</button></view>
