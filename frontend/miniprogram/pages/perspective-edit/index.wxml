<view class="page safe-page"><view class="paper"><view class="eyebrow">ANOTHER SIDE</view><view class="title">那天，在我眼里</view><textarea value="{{text}}" maxlength="500" placeholder="写下同一件小事的另一种感受…" bindinput="input"/><view class="photos"><view wx:for="{{files}}" wx:key="path" class="photo"><image src="{{item.thumb || item.path}}" mode="aspectFill"/><button data-index="{{index}}" bindtap="remove">×</button></view><button wx:if="{{files.length < 3}}" class="choose" bindtap="choose">＋ 照片</button></view><button class="save" loading="{{saving}}" bindtap="save">保存我的视角</button></view></view>
