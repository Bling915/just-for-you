.page{padding:32rpx}.paper{padding:36rpx;border-radius:30rpx;background:#fffaf4;box-shadow:0 18rpx 50rpx rgba(111,85,76,.1)}.eyebrow{color:#a48973;font-size:20rpx;letter-spacing:5rpx}.title{margin-top:12rpx;font-size:38rpx;font-weight:700}textarea{width:100%;height:260rpx;box-sizing:border-box;margin-top:28rpx;padding:24rpx;border-radius:20rpx;background:#fff;font-size:28rpx;line-height:1.7}.photos{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:24rpx}.photo,.choose{position:relative;width:180rpx;height:180rpx;border-radius:18rpx;overflow:hidden}.photo image{width:100%;height:100%}.photo button{position:absolute;top:6rpx;right:6rpx;width:44rpx;height:44rpx;padding:0;border-radius:50%;color:#fff;background:rgba(0,0,0,.45);line-height:44rpx}.choose{margin:0;padding:0;border:2rpx dashed #c9b8d8;color:#806aa8;background:#faf6fd;line-height:180rpx}.save{margin-top:40rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#9c82ba,#806aa8)}
