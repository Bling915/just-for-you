<view class="page safe-page"><view class="head"><view><view class="eyebrow">OUR CALENDAR</view><view class="title">共同日历</view></view><picker mode="date" fields="month" value="{{month}}" bindchange="change"><view class="month">{{month}}</view></picker></view><view class="week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="grid"><view wx:for="{{cells}}" wx:key="index" class="cell {{item.today?'today':''}}" data-date="{{item.date}}" bindtap="open"><text>{{item.day}}</text><view wx:if="{{item.count}}" class="dot">{{item.count}}</view></view></view></view>
