<view class="page safe-page"><view class="top"><view><view class="eyebrow">A QUIET CORNER</view><view class="title">{{title}}</view><view class="subtitle">{{subtitle}}</view></view><view class="paper-mark">✦</view></view><block wx:if="{{loading}}"><skeleton-card/><skeleton-card/></block><empty-state wx:elif="{{error}}" title="暂时看不到" description="{{error}}"/><empty-state wx:elif="{{!moments.length}}" title="这里还很安静" description="{{owner === 'me' ? '记下一件只属于自己的小事吧。' : 'TA 还没有分享个人小事。'}}" action="{{owner === 'me' ? '记录小事' : ''}}" bind:action="compose"/><block wx:else><moment-card wx:for="{{moments}}" wx:key="id" moment="{{item}}" current-user-id="{{currentUserId}}" current-user-avatar="{{currentUserAvatar}}" partner-avatar="{{partnerAvatar}}" bind:edit="edit" bind:delete="remove" bind:previewphotos="preview"/><view class="footer">{{loadingMore ? '正在翻开下一页…' : hasMore ? '继续向下' : '已经看到最早的小事了'}}</view></block><floating-compose-button wx:if="{{owner === 'me'}}" bind:compose="compose"/></view>
