.page{box-sizing:border-box;padding-bottom:80rpx}.top{display:flex;align-items:center;justify-content:space-between;margin:18rpx 6rpx 44rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.subtitle{margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.inline-compose{height:64rpx;margin:0;padding:0 24rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));box-shadow:0 10rpx 25rpx rgba(128,106,168,.2);font-size:22rpx;line-height:64rpx}.inline-compose::after{border:0}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
