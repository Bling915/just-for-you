.page{box-sizing:border-box;padding-bottom:190rpx}.top{display:flex;align-items:center;justify-content:space-between;margin:18rpx 6rpx 44rpx}.eyebrow{color:var(--color-primary);font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.subtitle{margin-top:10rpx;color:var(--color-text-muted);font-size:22rpx}.paper-mark{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:22rpx 34rpx 24rpx 38rpx;color:var(--color-primary-deep);background:#fff;box-shadow:var(--shadow-card);font-size:34rpx;transform:rotate(3deg)}.footer{padding:42rpx 0;color:var(--color-text-muted);font-size:22rpx;text-align:center}
