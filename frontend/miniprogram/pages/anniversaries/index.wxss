.page{padding-bottom:80rpx}.head{display:flex;align-items:flex-start;justify-content:space-between}.eyebrow{color:#9d87c1;font-size:18rpx;letter-spacing:5rpx}.title{margin-top:10rpx;font-size:44rpx;font-weight:720}.subtitle{max-width:510rpx;margin-top:14rpx;color:#83798b;font-size:23rpx;line-height:1.7}.head button{width:76rpx;height:76rpx;margin:10rpx 0 0;border:0;border-radius:50%;color:#fff;background:linear-gradient(145deg,#b49dce,#806aa8);box-shadow:0 14rpx 32rpx rgba(128,106,168,.25);font-size:38rpx;line-height:76rpx}.head button::after{border:0}.section-title{margin-top:46rpx;color:#5a5062;font-size:26rpx;font-weight:680}.notice,.empty{margin-top:60rpx;padding:44rpx;border-radius:28rpx;color:#83798b;background:rgba(255,255,255,.7);text-align:center}.empty text{display:block;margin-top:18rpx;color:#806aa8}
