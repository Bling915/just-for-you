<view class="page safe-page"><view wx:if="{{state==='loading'}}" class="notice">正在打开这份纪念…</view><view wx:elif="{{state==='error'}}" class="notice">暂时没有打开，再试一次吧。</view><block wx:else><anniversary-frame item="{{item}}" template="{{template}}"/><view class="templates"><view wx:for="{{templates}}" wx:key="id" class="{{template===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectTemplate">{{item.name}}</view></view><view class="actions"><button bindtap="preview" loading="{{generating}}">预览纪念卡</button><button class="primary" bindtap="savePoster" loading="{{generating}}">保存到相册</button></view><button class="edit" bindtap="edit">编辑纪念日</button><canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas></block></view>
