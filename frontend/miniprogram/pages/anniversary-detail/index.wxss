.templates{display:flex;justify-content:center;gap:14rpx;margin-top:34rpx}.templates view{padding:13rpx 22rpx;border-radius:999rpx;color:#83798b;background:rgba(255,255,255,.7);font-size:21rpx}.templates .active{color:#fff;background:#9d87c1}.actions{display:flex;gap:18rpx;margin-top:28rpx}.actions button{flex:1;margin:0;border:0;border-radius:42rpx;color:#806aa8;background:#eee7f8;font-size:24rpx}.actions .primary{color:#fff;background:linear-gradient(135deg,#ad96ce,#806aa8)}.actions button::after,.edit::after{border:0}.edit{margin-top:18rpx;border:0;border-radius:44rpx;color:#806aa8;background:transparent;font-size:22rpx}.notice{margin-top:80rpx;color:#83798b;text-align:center}.poster-canvas{position:fixed;left:-10000px;top:0;width:375px;height:667px}
